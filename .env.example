# Postgres
DATABASE_URL="postgresql://reachlist:reachlist@localhost:5432/reachlist?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Default region used when a CSV row has a national-format number with no country code.
# ISO 3166-1 alpha-2. Set this to the country most of your contacts are in.
DEFAULT_REGION="PK"

# Max rows accepted in a single upload
MAX_ROWS="500000"

# --- Stage 2 (not used by the CSV pipeline, reserved) ---
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# --- /validate presence checks ---
# WhatsApp needs nothing here: visitors link their own account by QR.
# Telegram needs an *application* registered once by whoever runs this server,
# at https://my.telegram.org -> API development tools. These identify the app,
# not any user; visitors still link their own account by QR.
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# Optional: route Telegram's MTProto connection through a proxy. Needed where
# Telegram is IP-blocked (DNS resolves, but TCP 443 to 149.154.0.0/16 hangs).
# Set _SECRET for an MTProxy, or _SOCKS=5 for a SOCKS5 proxy.
# TELEGRAM_PROXY_IP=""
# TELEGRAM_PROXY_PORT=""
# TELEGRAM_PROXY_SECRET=""
# TELEGRAM_PROXY_SOCKS=""
# TELEGRAM_PROXY_USER=""
# TELEGRAM_PROXY_PASS=""

# --- lookup pacing (speed vs account safety) ---
# Lower delays are faster and raise the chance of the linked account being
# limited or banned. The defaults are deliberately conservative.
# WHATSAPP_DELAY_MS="7000"     # pause between WhatsApp lookups (1 per call)
# WHATSAPP_MAX_LOOKUPS="200"   # cap per run
# TELEGRAM_BATCH="5"           # numbers per importContacts call — biggest speed lever
# TELEGRAM_DELAY_MS="15000"    # pause between those calls
# TELEGRAM_MAX_LOOKUPS="100"   # cap per run

# Set to 1 only when running behind a proxy you control (nginx, Cloudflare).
# It makes the rate limiter trust X-Forwarded-For; with no proxy in front,
# leaving this unset is correct — otherwise anyone can forge a fresh bucket.
# TRUST_PROXY="1"

# --- GREEN-API (hosted WhatsApp/Telegram lookups) ---
# Configure a channel here and it bypasses our own session entirely: no QR,
# no Chromium, nothing to lose on a restart. Leave blank to keep using the
# linked session for that channel. Values come from the instance page at
# console.green-api.com; the token is a secret, keep it out of git.
# GREENAPI_WA_ID=""
# GREENAPI_WA_TOKEN=""
# GREENAPI_WA_URL="https://7105.api.greenapi.com"
# GREENAPI_TG_ID=""
# GREENAPI_TG_TOKEN=""
# GREENAPI_TG_URL="https://4100.api.greenapi.com"
